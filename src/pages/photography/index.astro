---
import PhotographyLayout from "../../layouts/PhotographyLayout.astro";
import { getPhotoCollections } from "../../lib/photography";

const CYCLE_MIN_MS = 2000;
const CYCLE_VARIANCE_MS = 5500;
const FADE_DURATION_MS = 400;

const collections = await getPhotoCollections();
---

<PhotographyLayout>
  <div class="grid-scroll flex-1 min-w-0 h-full overflow-auto">
    <div
      class="photo-grid grid-cols-1 md:grid-cols-6"
      style={`--cell-fade-ms: ${FADE_DURATION_MS}ms`}
    >
      {
        collections.map((collection, i) => (
          <a
            id={`cell-${i}`}
            href={`/photography/${collection.slug}`}
            class:list={["grid-cell", { "is-featured": collection.featured }]}
            data-cell-id={`cell-${i}`}
            data-name={collection.name}
            data-date={
              collection.date ? collection.date.toISOString().slice(0, 10) : ""
            }
            data-photos={JSON.stringify(collection.photos.map((p) => p.src))}
            aria-label={collection.name}
          >
            <img
              src={collection.photos[0].src}
              alt={collection.photos[0]?.alt ?? collection.name}
              loading="lazy"
              decoding="async"
              class="cell-img"
            />
          </a>
        ))
      }
    </div>
  </div>

  <div id="hover-panel" class="hover-panel" aria-hidden="true">
    <span id="hover-name" class="hover-name"></span>
    <span id="hover-date" class="hover-date"></span>
  </div>
</PhotographyLayout>

<style>
  .grid-scroll {
    padding: 0.75rem;
    box-sizing: border-box;
  }

  .photo-grid {
    display: grid;
    grid-auto-rows: 350px;
    gap: 4px;
    width: 100%;
    padding: 40px;
  }

  @media (min-width: 768px) {
    .photo-grid {
      grid-auto-rows: min(calc(100vw / 6), 250px);
    }
  }

  .grid-cell {
    position: relative;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: transparent;
    cursor: pointer;
    text-decoration: none;
    outline: none;
    transition:
      opacity 0.25s ease,
      filter 0.25s ease;
  }

  .grid-cell.is-featured {
    background-color: color-mix(in srgb, var(--color-accent) 0%, transparent);
  }

  .grid-cell:hover {
    background-color: color-mix(in srgb, var(--color-accent) 80%, transparent);
  }

  .grid-cell:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .photo-grid:has(.grid-cell:hover) .grid-cell:not(:hover),
  .photo-grid:has(.grid-cell:focus-visible) .grid-cell:not(:focus-visible) {
    opacity: 0.1;
    filter: grayscale(1);
  }

  .cell-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    margin-top: auto;
    margin-right: auto;
    transition: opacity var(--cell-fade-ms, 400ms) ease;
  }

  .cell-img.is-fading {
    opacity: 0;
  }

  .hover-panel {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 40;
    display: inline-flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.2rem 1.2rem;
    background-color: var(--color-accent);
    color: var(--color-invert);
    opacity: 0;
    transform: translateY(6px);
    pointer-events: none;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
    max-width: min(80vw, 420px);
  }

  .hover-panel.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .hover-name {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.1;
  }

  .hover-date {
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.85;
    line-height: 1.1;
  }
</style>

<script
  define:vars={{
    CYCLE_MIN_MS,
    CYCLE_VARIANCE_MS,
    FADE_DURATION_MS,
  }}
>
  let stopPhotoGrid = null;

  function randomIdleMs() {
    const r = Math.random();
    return CYCLE_MIN_MS + r * r * CYCLE_VARIANCE_MS;
  }

  function setupPhotoGrid() {
    if (stopPhotoGrid) stopPhotoGrid();

    const grid = document.querySelector(".photo-grid");
    const cells = Array.from(document.querySelectorAll(".grid-cell"));
    const panel = document.getElementById("hover-panel");
    const nameEl = document.getElementById("hover-name");
    const dateEl = document.getElementById("hover-date");

    const cellState = cells
      .map((cell, i) => {
        const raw = cell.getAttribute("data-photos") ?? "[]";
        let photos = [];
        try {
          photos = JSON.parse(raw);
        } catch {
          photos = [];
        }

        const img = cell.querySelector(".cell-img");
        if (!img || photos.length <= 1) return null;

        const startDelay = Math.random() * (CYCLE_MIN_MS + CYCLE_VARIANCE_MS);

        for (let p = 1; p < photos.length; p++) {
          const preload = new Image();
          preload.src = photos[p];
        }

        return {
          img,
          photos,
          index: 0,
          phase: "waiting",
          timeUntilFade: startDelay,
          phaseEndsAt: 0,
        };
      })
      .filter((s) => s !== null);

    let rafId = 0;
    let lastTick = 0;
    let stopped = false;

    function tick(now) {
      if (stopped) return;
      if (lastTick === 0) lastTick = now;

      const rawDt = now - lastTick;
      const isPaused = grid
        ? grid.querySelector(".grid-cell:hover") !== null
        : false;
      lastTick = now;

      if (isPaused) {
        for (const s of cellState) {
          if (s.phase === "fade-out" || s.phase === "fade-in") {
            s.phaseEndsAt += rawDt;
          }
        }
        rafId = requestAnimationFrame(tick);
        return;
      }

      const dt = Math.min(rawDt, 500);

      for (const s of cellState) {
        if (s.phase === "fade-out") {
          if (now < s.phaseEndsAt) continue;
          s.img.src = s.photos[s.index];
          s.img.classList.remove("is-fading");
          s.phase = "fade-in";
          s.phaseEndsAt = now + FADE_DURATION_MS;
          continue;
        }

        if (s.phase === "fade-in") {
          if (now < s.phaseEndsAt) continue;
          s.phase = "waiting";
          s.timeUntilFade = randomIdleMs();
          continue;
        }

        s.timeUntilFade -= dt;
        if (s.timeUntilFade <= 0) {
          s.index = (s.index + 1) % s.photos.length;
          s.img.classList.add("is-fading");
          s.phase = "fade-out";
          s.phaseEndsAt = now + FADE_DURATION_MS;
          s.timeUntilFade = 0;
        }
      }

      rafId = requestAnimationFrame(tick);
    }

    function formatDate(iso) {
      if (!iso) return "";
      const d = new Date(iso);
      if (Number.isNaN(d.getTime())) return "";
      return d.toLocaleDateString("en-GB", {
        month: "short",
        year: "numeric",
      });
    }

    cells.forEach((cell) => {
      cell.addEventListener("mouseenter", () => {
        if (!panel || !nameEl || !dateEl) return;
        const name = cell.getAttribute("data-name") ?? "";
        const date = cell.getAttribute("data-date") ?? "";
        nameEl.textContent = name;
        dateEl.textContent = formatDate(date);
        panel.classList.add("is-visible");
      });

      cell.addEventListener("mouseleave", () => {
        if (!panel) return;
        panel.classList.remove("is-visible");
      });

      cell.addEventListener("focus", () => {
        if (!panel || !nameEl || !dateEl) return;
        const name = cell.getAttribute("data-name") ?? "";
        const date = cell.getAttribute("data-date") ?? "";
        nameEl.textContent = name;
        dateEl.textContent = formatDate(date);
        panel.classList.add("is-visible");
      });

      cell.addEventListener("blur", () => {
        if (!panel) return;
        panel.classList.remove("is-visible");
      });
    });

    function stop() {
      stopped = true;
      if (rafId !== 0) cancelAnimationFrame(rafId);
      if (stopPhotoGrid === stop) stopPhotoGrid = null;
    }

    stopPhotoGrid = stop;
    document.addEventListener("astro:before-swap", stop, { once: true });

    if (cellState.length > 0) {
      rafId = requestAnimationFrame(tick);
    }
  }

  document.addEventListener("astro:page-load", setupPhotoGrid);
</script>
