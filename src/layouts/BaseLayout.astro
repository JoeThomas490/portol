---
import { ClientRouter, fade } from "astro:transitions";

import Favicons from "../components/Favicons.astro";

interface Props {
  title: string;
  description?: string;
  mode?: "photography" | "programming" | "base" | "about";
}

interface Breadcrumb {
  label: string;
  href: string;
  isActive: boolean;
}

const navLinks = [
  { name: "Photography", href: "/photography" },
  { name: "Programming", href: "/programming" },
  { name: "About", href: "/about" },
];

const { title, description = "joenoseph", mode = "base" } = Astro.props;

const isLanding = Astro.url.pathname === "/";

function buildBreadcrumbs(pathname: string): Breadcrumb[] {
  const segments = pathname.split("/").filter(Boolean);
  const crumbs: Breadcrumb[] = [
    { label: "joenoseph", href: "/", isActive: segments.length === 0 },
  ];

  let path = "";
  for (let i = 0; i < segments.length; i++) {
    path += `/${segments[i]}`;
    const isLast = i === segments.length - 1;
    crumbs.push({
      label: segments[i],
      href: path,
      isActive: isLast,
    });
  }

  return crumbs;
}

const breadcrumbs = buildBreadcrumbs(Astro.url.pathname);

const customFade = {
  forwards: fade({ duration: "0.4s" }).forwards,
  backwards: fade({ duration: "0.4s" }).backwards,
};
---

<!doctype html>
<html
  lang="en"
  data-mode={mode !== "base" ? mode : undefined}
  transition:name="root"
  transition:animate={customFade}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <Favicons variant={mode} />
    <title>{title.toLowerCase()} | joenoseph</title>
    <ClientRouter />
  </head>
  <body
    class:list={[
      "min-h-dvh",
      mode === "base" && "bg-neutral-950 text-neutral-300",
    ]}
    style={mode !== "base"
      ? `background-color: var(--color-bg); color: var(--color-text);`
      : undefined}
  >
    <nav
      transition:animate={customFade}
      class="fixed top-0 left-0 right-0 z-50 p-6"
    >
      <div class="flex items-start justify-between">
        <div class="flex flex-col items-start gap-0 text-(--color-text)">
          <div
            id="site-logo"
            aria-label="Breadcrumb"
            class="flex flex-wrap items-center gap-x-1.5"
            role="navigation"
          >
            {
              breadcrumbs.map((crumb) => (
                <a
                  href={crumb.href}
                  class:list={[
                    "text-lg font-bold tracking-tight no-underline transition-colors duration-300",
                    crumb.isActive
                      ? "text-(--color-accent)"
                      : mode === "base"
                        ? "text-neutral-400 hover:text-white"
                        : "hover:opacity-80",
                  ]}
                  style={
                    !crumb.isActive && mode !== "base"
                      ? "color: var(--color-text);"
                      : undefined
                  }
                  aria-current={crumb.isActive ? "page" : undefined}
                >
                  {crumb.label}
                  {crumb.isActive && (
                    <span class="ml-0.5" aria-hidden="true">
                      *
                    </span>
                  )}
                </a>
              ))
            }
          </div>
          <!-- {
            mode !== "base" && (
              <span
                class="text-lg font-bold tracking-tight text-orange-400 -mt-2 ml-4"
                id="mode-label"
              >
                {mode}
              </span>
            )
          } -->
        </div>
        <!-- {
          !isLanding && (
            <div class="flex items-start justify-end gap-4">
              {navLinks.map((link) => {
                const Icon = link.icon;
                const isActive = Astro.url.pathname.startsWith(link.href);
                return (
                  <a
                    href={link.href}
                    class:list={[
                      "flex items-center gap-1.5 text-sm font-medium no-underline transition-colors duration-300 bg-green-500/20 rounded-md px-2 py-1",
                      isActive
                        ? "text-green-500"
                        : mode === "base"
                          ? "text-neutral-500 hover:text-white"
                          : "",
                    ]}
                    style={
                      !isActive && mode !== "base"
                        ? "color: var(--color-text); opacity: 0.6;"
                        : undefined
                    }
                  >
                    <span>{link.name}</span>
                  </a>
                );
              })}
            </div>
          )
        } -->
      </div>
    </nav>

    <main class={mode !== "base" ? "pt-4" : ""} transition:animate={customFade}>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
  @import "../styles/transitions.css";
  @import "../styles/modes/photography.css";
  @import "../styles/modes/programming.css";
  @import "../styles/modes/about.css";

  @keyframes fade {
    0% {
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }
</style>
